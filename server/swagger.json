  "info": {
    "title": "勤怠管理システム API",
    "description": "マルチテナント勤怠管理システムのREST API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "株式会社サンプル"
          },
          "adminEmail": {
            "type": "string",
            "example": "admin@example.com"
          },
          "adminName": {
            "type": "string",
            "example": "田中太郎"
          }
        },
        "required": [
          "name",
          "adminEmail",
          "adminName"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "株式会社サンプル更新"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "山田花子"
          },
          "role": {
            "type": "string",
            "enum": [
              "tenant_admin",
              "tenant_user"
            ],
            "default": "tenant_user"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "山田花子（改）"
          }
        }
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tenant_admin",
              "tenant_user"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateEmployeeDto": {
        "type": "object",
        "properties": {
          "employeeNumber": {
            "type": "string",
            "example": "EMP001"
          },
          "name": {
            "type": "string",
            "example": "山田太郎"
          },
          "joinedAt": {
            "type": "string",
            "example": "2024-04-01"
          },
          "userId": {
            "type": "string",
            "description": "紐付けるユーザーID"
          },
          "departmentId": {
            "type": "string",
            "description": "部署ID"
          },
          "workPatternId": {
            "type": "string",
            "description": "勤務形態ID"
          }
        },
        "required": [
          "employeeNumber",
          "name",
          "joinedAt"
        ]
      },
      "UpdateEmployeeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "departmentId": {
            "type": "string"
          },
          "workPatternId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "CreateClockCorrectionDto": {
        "type": "object",
        "properties": {
          "attendanceId": {
            "type": "string",
            "description": "対象勤怠レコードID"
          },
          "correctedClockIn": {
            "type": "string",
            "description": "修正後出勤時刻（ISO8601）"
          },
          "correctedClockOut": {
            "type": "string",
            "description": "修正後退勤時刻（ISO8601）"
          },
          "reason": {
            "type": "string",
            "description": "修正理由"
          }
        },
        "required": [
          "attendanceId",
          "reason"
        ]
      },
      "CreateLeaveRequestDto": {
        "type": "object",
        "properties": {
          "leaveType": {
            "type": "string",
            "enum": [
              "paid",
              "unpaid",
              "sick",
              "other"
            ]
          },
          "startDate": {
            "type": "string",
            "example": "2026-05-01"
          },
          "endDate": {
            "type": "string",
            "example": "2026-05-03"
          },
          "reason": {
            "type": "string",
            "example": "私用のため"
          }
        },
        "required": [
          "leaveType",
          "startDate",
          "endDate"
        ]
      },
      "CreateClosingDto": {
        "type": "object",
        "properties": {
          "yearMonth": {
            "type": "string",
            "example": "2026-04",
            "description": "対象年月（YYYY-MM）"
          }
        },
        "required": [
          "yearMonth"
        ]
      },
      "CreateDepartmentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "開発部"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateWorkPatternDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "通常勤務"
          },
          "startTime": {
            "type": "string",
            "example": "09:00:00",
            "description": "所定開始時刻（HH:MM:SS）"
          },
          "endTime": {
            "type": "string",
            "example": "18:00:00",
            "description": "所定終了時刻（HH:MM:SS）"
          },
          "breakMinutes": {
            "type": "number",
            "example": 60,
            "description": "所定休憩時間（分）"
          }
        },
        "required": [
          "name",
          "startTime",
          "endTime"
        ]
      }
    }
  }
}